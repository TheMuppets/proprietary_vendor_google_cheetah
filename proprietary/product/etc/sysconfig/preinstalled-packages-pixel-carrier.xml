<config>
    <!-- Tethering Entitlement (TetheringEntitlement) -->
    <install-in-user-type package="com.google.android.tetheringentitlement">
        <install-in user-type="SYSTEM" />
        <install-in user-type="FULL" />
    </install-in-user-type>
    <!-- Carrier Setup (CarrierSetup) -->
    <install-in-user-type package="com.google.android.carriersetup">
        <install-in user-type="FULL" />
    </install-in-user-type>
    <!-- Google Wi-Fi Provisioner app (CarrierWiFi) -->
    <install-in-user-type package="com.google.android.apps.carrier.carrierwifi">
        <install-in user-type="FULL" />
    </install-in-user-type>
    <!-- WFC Activation (WfcActivation) -->
    <install-in-user-type package="com.google.android.wfcactivation">
        <install-in user-type="SYSTEM" />
        <install-in user-type="FULL" />
    </install-in-user-type>

    <!-- Adaptive Connectivity Services (SCONE) -->
    <install-in-user-type package="com.google.android.apps.scone">
        <install-in user-type="SYSTEM" />
        <install-in user-type="android.os.usertype.profile.MANAGED" />
    </install-in-user-type>

    <!-- OMADM Service (DMService) -->
    <install-in-user-type package="com.android.omadm.service">
        <install-in user-type="SYSTEM" />
        <install-in user-type="FULL" />
    </install-in-user-type>
    <!-- OMADM Trigger (OemDmTrigger) -->
    <install-in-user-type package="com.google.omadm.trigger">
        <install-in user-type="SYSTEM" />
        <install-in user-type="FULL" />
    </install-in-user-type>
    <!-- OMADM ConnMO Plugin (ConnMO) -->
    <install-in-user-type package="com.android.sdm.plugins.connmo">
        <install-in user-type="SYSTEM" />
        <install-in user-type="FULL" />
    </install-in-user-type>
    <!-- OMADM DCMO Plugin (DCMO) -->
    <install-in-user-type package="com.android.sdm.plugins.dcmo">
        <install-in user-type="SYSTEM" />
        <install-in user-type="FULL" />
    </install-in-user-type>
    <!-- OMADM DiagMon Plugin (DiagMon) -->
    <install-in-user-type package="com.android.sdm.plugins.diagmon">
        <install-in user-type="SYSTEM" />
        <install-in user-type="FULL" />
    </install-in-user-type>
    <!-- Google eSIM Manager (EuiccGoogle) -->
    <install-in-user-type package="com.google.android.euicc">
        <install-in user-type="SYSTEM" />
        <install-in user-type="FULL" />
        <install-in user-type="PROFILE" />
    </install-in-user-type>
    <!-- NFC/eSE/eSIM firmware updater (EuiccSupportPixel) -->
    <install-in-user-type package="com.google.euiccpixel">
        <install-in user-type="SYSTEM" />
    </install-in-user-type>
    <!-- NFC/eSE/eSIM firmware updater Permissions (EuiccSupportPixelPermissions) -->
    <install-in-user-type package="com.google.euiccpixel.permissions">
        <install-in user-type="SYSTEM" />
    </install-in-user-type>
</config>
